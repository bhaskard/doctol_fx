# Copy to .env and fill in real values before running deploy.sh

# Domain
DOMAIN=yourdomain.com

# Auth (generate with: openssl rand -base64 32)
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database (generate with: openssl rand -hex 16)
POSTGRES_PASSWORD=

# Redis (generate with: openssl rand -hex 16)
REDIS_PASSWORD=

# AI
ANTHROPIC_API_KEY=sk-ant-...

# Integrations (https://composio.dev/dashboard)
COMPOSIO_API_KEY=

# Slack Bot (https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# Telegram Bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Internal signing (generate with: openssl rand -hex 32)
JOB_HMAC_SECRET=

# Docker registry (optional, for CI/CD)
REGISTRY=ghcr.io/yourorg
TAG=latest
