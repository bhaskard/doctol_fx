# === REQUIRED ===

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Auth (generate with: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Database (auto-generated in Docker; set for external DB)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/duet

# Redis (auto-generated in Docker)
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Security secrets (generate with: openssl rand -hex 32)
JOB_HMAC_SECRET=
CIPHER_KEY=

# === OPTIONAL (features disabled if blank) ===

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/applications/new)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Composio (https://composio.dev/dashboard)
COMPOSIO_API_KEY=

# Slack Bot (https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# Telegram Bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=   # any random string

# App hosting
HOSTED_APPS_DIR=/var/hosted-apps
HOSTED_APPS_DOMAIN=apps.yourdomain.com

# Stripe (Phase 7 billing — leave blank until needed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
