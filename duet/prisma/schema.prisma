generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String               @id @default(cuid())
  name             String?
  email            String?              @unique
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime             @default(now())
  accounts         Account[]
  sessions         Session[]
  agentSession     AgentSession?
  integrations     Integration[]
  scheduledTasks   ScheduledTask[]
  hostedApps       HostedApp[]
  memories         AgentMemory[]
  usageRecords     UsageRecord[]
  plan             UserPlan?
  agentJobs        AgentJob[]
  slackMappings    SlackUserMapping[]
  telegramMappings TelegramChatMapping[]
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Agent state
model AgentSession {
  id              String   @id @default(cuid())
  userId          String   @unique
  claudeSessionId String?  // encrypted, for context resume
  status          String   @default("idle") // idle | running | error
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

model AgentJob {
  id        String   @id @default(cuid())
  userId    String
  bullJobId String?
  status    String   @default("queued") // queued | running | done | error
  result    String?  @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

// Per-user memory (replaces /tmp persistence)
model AgentMemory {
  id       String @id @default(cuid())
  userId   String
  filename String // e.g. "writing_style.md"
  content  String @db.Text
  user     User   @relation(fields: [userId], references: [id])

  @@unique([userId, filename])
}

// Composio OAuth integrations
model Integration {
  id             String  @id @default(cuid())
  userId         String
  provider       String  // "gmail" | "slack" | "notion" | "hubspot" ...
  composioConnId String
  status         String  @default("active")
  user           User    @relation(fields: [userId], references: [id])

  @@unique([userId, provider])
}

// Scheduled tasks
model ScheduledTask {
  id        String    @id @default(cuid())
  userId    String
  name      String
  prompt    String    @db.Text
  cronExpr  String
  timezone  String    @default("UTC")
  enabled   Boolean   @default(true)
  lastRun   DateTime?
  user      User      @relation(fields: [userId], references: [id])
}

// AI-generated hosted apps
model HostedApp {
  id        String   @id @default(cuid())
  userId    String
  slug      String   @unique
  html      String   @db.Text // sanitized HTML only
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

// Token usage tracking for billing
model UsageRecord {
  id           String   @id @default(cuid())
  userId       String
  inputTokens  Int
  outputTokens Int
  model        String
  taskType     String
  runAt        DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

// Plan limits
model UserPlan {
  id                   String   @id @default(cuid())
  userId               String   @unique
  plan                 String   @default("free") // free | starter | pro | team
  tokenBudgetMonthly   Int      @default(20000)  // free=20K, starter=2M, pro=10M
  tokensUsedThisMonth  Int      @default(0)
  billingCycleStart    DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id])
}

// Bot channel mappings
model SlackUserMapping {
  id          String @id @default(cuid())
  slackUserId String @unique
  userId      String
  user        User   @relation(fields: [userId], references: [id])
}

model TelegramChatMapping {
  id     String @id @default(cuid())
  chatId String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id])
}
